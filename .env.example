# Sanity project. Both are needed at BUILD time (Vercel: Project Settings -> Environment Variables),
# because Vite bakes them into the site. Without them the site shows its built-in content only.
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Only needed locally, for `npm run seed`. Never set this in Vercel.
# Create at sanity.io/manage -> your project -> API -> Tokens (permission: Editor).
SANITY_WRITE_TOKEN=
